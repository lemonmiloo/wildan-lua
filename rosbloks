-- SEED LOG
-- ═══════════════════════════════════════════════════════════════

log("GUI ready", C.green)
log("step 1 — LEARN, place+break blocks in-game, watch IDs appear")
log("step 2 — fill tile id fields + mature ids")
log("step 3 — CALIBRATE, wait ~15s")
log("step 4 — START")

if Config.autoStart and not Config.enabled then
    task.delay(2, function()
        Farm.start()
        log("autoStart engaged", C.green)
    end)
end

return { gui = gui, log = log }
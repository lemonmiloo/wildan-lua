local CONFIG_PATH = "growblox_farm_config.json"

local function saveConfig()
    if not writefile then
        log("save skipped (no writefile)", Color3.fromRGB(200, 180, 120))
        return false
    end
    local data = {}
    for k, v in pairs(Config) do
        if type(v) ~= "function" then
            data[k] = v
        end
    end
    local ok = pcall(function()
        writefile(CONFIG_PATH, HttpService:JSONEncode(data))
    end)
    log(ok and "config saved" or "config save failed",
        ok and Color3.fromRGB(160, 220, 160) or Color3.fromRGB(220, 120, 120))
    return ok
end

local function loadConfig()
    if not readfile or not isfile or not isfile(CONFIG_PATH) then return false end
    local ok, decoded = pcall(function()
        return HttpService:JSONDecode(readfile(CONFIG_PATH))
    end)
    if not ok or type(decoded) ~= "table" then return false end
    for k, v in pairs(decoded) do
        if Config[k] ~= nil and type(Config[k]) ~= "function" then
            Config[k] = v
        end
    end
    log("config loaded", Color3.fromRGB(160, 220, 160))
    return true
end

loadConfig()


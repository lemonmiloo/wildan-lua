local function makeIDListInput(row, getArray, setArray)
    local box = Instance.new("TextBox")
    box.Size = UDim2.new(0, 200, 1, -8)
    box.Position = UDim2.new(1, -200, 0, 4)
    box.BackgroundColor3 = C.input
    box.BorderSizePixel = 0
    box.Font = FONT_MED
    box.TextSize = 12
    box.TextColor3 = C.text
    box.PlaceholderText = "1,2,3"
    box.PlaceholderColor3 = C.muted
    local function render()
        local parts = {}
        for id in pairs(getArray()) do parts[#parts + 1] = tostring(id) end
        table.sort(parts, function(a, b) return tonumber(a) < tonumber(b) end)
        box.Text = table.concat(parts, ",")
    end
    render()
    box.ClearTextOnFocus = false
    box.Parent = row
    local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(0, 4); c.Parent = box
    local pad = Instance.new("UIPadding"); pad.PaddingLeft = UDim.new(0, 6); pad.Parent = box
    box.FocusLost:Connect(function()
        local out = {}
        for tok in string.gmatch(box.Text, "[^,%s]+") do
            local n = tonumber(tok)
            if n then out[math.floor(n)] = true end
        end
        setArray(out)
        render()
    end)
    return box
end

local function makeDropdown(row, getValue, setValue, options)
    local current = getValue()
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0, 140, 1, -8)
    btn.Position = UDim2.new(1, -140, 0, 4)
    btn.BackgroundColor3 = C.input
    btn.BorderSizePixel = 0
    btn.Font = FONT_MED
    btn.TextSize = 12
    btn.TextColor3 = C.text
    btn.Text = tostring(current)
    btn.TextXAlignment = Enum.TextXAlignment.Left
    btn.Parent = row
    local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(0, 4); c.Parent = btn
    local pad = Instance.new("UIPadding"); pad.PaddingLeft = UDim.new(0, 6); pad.Parent = btn

    local dropdown
    btn.MouseButton1Click:Connect(function()
        if dropdown then
            dropdown:Destroy()
            dropdown = nil
            return
        end
        dropdown = Instance.new("Frame")
        dropdown.Size = UDim2.fromOffset(140, #options * 26 + 4)
        dropdown.Position = UDim2.new(1, -140, 0, 28)
        dropdown.BackgroundColor3 = C.panel
        dropdown.BorderSizePixel = 0
        dropdown.ZIndex = 10
        dropdown.Parent = row
        local dc = Instance.new("UICorner"); dc.CornerRadius = UDim.new(0, 6); dc.Parent = dropdown
        local ds = Instance.new("UIStroke"); ds.Color = C.border; ds.Thickness = 1; ds.Parent = dropdown
        local list = Instance.new("UIListLayout")
        list.Padding = UDim.new(0, 1); list.Parent = dropdown
        local dpad = Instance.new("UIPadding"); dpad.PaddingTop = UDim.new(0, 2); dpad.Parent = dropdown

        for _, opt in ipairs(options) do
            local o = Instance.new("TextButton")
            o.Size = UDim2.new(1, -4, 0, 24)
            o.BackgroundColor3 = (opt == current) and C.accent or C.input
            o.BorderSizePixel = 0
            o.Font = FONT
            o.TextSize = 12
            o.TextColor3 = C.text
            o.Text = tostring(opt)
            o.ZIndex = 11
            o.Parent = dropdown
            local oc = Instance.new("UICorner"); oc.CornerRadius = UDim.new(0, 4); oc.Parent = o
            o.MouseButton1Click:Connect(function()
                current = opt
                setValue(opt)
                btn.Text = tostring(opt)
                if dropdown then dropdown:Destroy(); dropdown = nil end
            end)
        end
    end)

    return btn
end


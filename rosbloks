local function makeNumberInput(row, getValue, setValue, isInt)
    local box = Instance.new("TextBox")
    box.Size = UDim2.new(0, 120, 1, -8)
    box.Position = UDim2.new(1, -120, 0, 4)
    box.BackgroundColor3 = C.input
    box.BorderSizePixel = 0
    box.Font = FONT_MED
    box.TextSize = 12
    box.TextColor3 = C.text
    box.PlaceholderText = "number"
    box.PlaceholderColor3 = C.muted
    box.Text = tostring(getValue())
    box.ClearTextOnFocus = false
    box.Parent = row
    local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(0, 4); c.Parent = box
    local pad = Instance.new("UIPadding")
    pad.PaddingLeft = UDim.new(0, 6)
    pad.Parent = box

    local function commit()
        local n = tonumber(box.Text)
        if not n then
            box.Text = tostring(getValue())
            return
        end
        if isInt then n = math.floor(n) end
        setValue(n)
    end

    box.FocusLost:Connect(commit)
    return box
end

local function makeNumberInputAllowNil(row, getValue, setValue)
    local box = Instance.new("TextBox")
    box.Size = UDim2.new(0, 120, 1, -8)
    box.Position = UDim2.new(1, -120, 0, 4)
    box.BackgroundColor3 = C.input
    box.BorderSizePixel = 0
    box.Font = FONT_MED
    box.TextSize = 12
    box.TextColor3 = C.text
    box.PlaceholderText = "nil"
    box.PlaceholderColor3 = C.muted
    local v = getValue()
    box.Text = v and tostring(v) or ""
    box.ClearTextOnFocus = false
    box.Parent = row
    local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(0, 4); c.Parent = box
    local pad = Instance.new("UIPadding"); pad.PaddingLeft = UDim.new(0, 6); pad.Parent = box

    box.FocusLost:Connect(function()
        local s = box.Text
        if s == "" then
            setValue(nil)
        else
            local n = tonumber(s)
            if n then setValue(math.floor(n)) else box.Text = "" end
        end
    end)
    return box
end


-- ═══════════════════════════════════════════════════════════════
-- LOG SYSTEM
-- ═══════════════════════════════════════════════════════════════

local MAX_LOG = 200
local LogEntries = {}
local LogListeners = {}

local function log(msg, color)
    local entry = {
        text  = os.date("%H:%M:%S") .. "  " .. tostring(msg),
        color = color or Color3.fromRGB(210, 215, 230),
    }
    table.insert(LogEntries, 1, entry)
    while #LogEntries > MAX_LOG do
        table.remove(LogEntries)
    end
    for _, fn in ipairs(LogListeners) do
        pcall(fn, entry)
    end
end

-- ═══════════════════════════════════════════════════════════════
-- PACKET SEND HOOKS (activity feed)
-- ═══════════════════════════════════════════════════════════════

local function hookSend(packet, tag, color)
    if not packet or not packet.send then return end
    local orig = packet.send
    packet.send = function(payload)
        if payload and payload.x ~= nil and payload.y ~= nil then
            log(("%s → (%s,%s)"):format(tag, tostring(payload.x), tostring(payload.y)), color)
        else
            log(tag .. " → send", color)
        end
        return orig(payload)
    end
end

hookSend(Net.tile,    "tile",    Color3.fromRGB(150, 200, 255))
hookSend(Net.splice,  "splice",  Color3.fromRGB(180, 220, 150))
hookSend(Net.harvest, "harvest", Color3.fromRGB(230, 200, 130))
hookSend(Net.act,     "act",     Color3.fromRGB(200, 170, 240))


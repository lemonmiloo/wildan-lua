makeSection("Controls")

local startBtnRef, stopBtnRef

startBtnRef = makeActionRow("Farm loop", "START", function()
    if Config.enabled then
        log("already running", C.yellow)
        return
    end
    Farm.start()
    log("farm started", C.green)
    if startBtnRef then startBtnRef.btn.Text = "RUNNING"; startBtnRef.btn.BackgroundColor3 = C.muted end
    if stopBtnRef  then stopBtnRef.btn.Text  = "STOP"   ; stopBtnRef.btn.BackgroundColor3  = C.red    end
end, C.green)

stopBtnRef = makeActionRow("Halt loop", "STOP", function()
    if not Config.enabled then
        log("not running", C.yellow)
        return
    end
    Farm.stop()
    log("farm stopped", C.red)
    if startBtnRef then startBtnRef.btn.Text = "START"; startBtnRef.btn.BackgroundColor3 = C.green end
    if stopBtnRef  then stopBtnRef.btn.Text  = "STOP" ; stopBtnRef.btn.BackgroundColor3  = C.red   end
end, C.red)

makeActionRow("Learn tile IDs (60s)", "LEARN", function()
    log("learner armed 60s — place+break blocks manually", C.yellow)
    Farm.learn(60)
end, C.yellow)

makeActionRow("Calibrate grid", "CALIBRATE", function()
    if Config.enabled then
        log("stop farm before calibrating", C.yellow)
        return
    end
    log("calibration started", C.yellow)
    Farm.calibrate()
end, C.accent)

makeActionRow("Save config to disk", "SAVE", function()
    saveConfig()
end, C.accent)

makeActionRow("Clear rejected cache", "RESET", function()
    local n = 0
    for k in pairs(World.rejected) do
        World.rejected[k] = nil
        n = n + 1
    end
    log(("cleared %d rejected tiles"):format(n), C.green)
end, C.yellow)

makeActionRow("Destroy GUI", "CLOSE", function()
    saveConfig()
    gui:Destroy()
    _G.GrowbloxFarmGUI = nil
end, C.muted)

-- ═══════════════════════════════════════════════════════════════
-- MINIMIZE
-- ═══════════════════════════════════════════════════════════════

local minimized = false
local savedSize = win.Size
minBtn.MouseButton1Click:Connect(function()
    minimized = not minimized
    if minimized then
        savedSize = win.Size
        win.Size = UDim2.fromOffset(WIN_W, 34)
    else
        win.Size = savedSize
    end
end)

-- ═══════════════════════════════════════════════════════════════
-- CLOSE
-- ═══════════════════════════════════════════════════════════════

closeBtn.MouseButton1Click:Connect(function()
    saveConfig()
    gui:Destroy()
    _G.GrowbloxFarmGUI = nil
end)

-- ═══════════════════════════════════════════════════════════════
-- LIVE STATUS
-- ═══════════════════════════════════════════════════════════════

task.spawn(function()
    while gui.Parent do
        task.wait(1)
        local ok, st = pcall(Farm.status)
        if ok and st then
            local total = st.total or 1
            local knownPct = math.floor((st.known / total) * 100 + 0.5)
            local stateColor = Config.enabled and C.green or C.muted
            statusLabel.Text = ("%s   world=%s   known %d/%d (%d%%)   empty=%d   mature=%d")
                :format(
                    Config.enabled and "RUNNING" or "IDLE",
                    tostring(st.world == "" and "?" or st.world),
                    st.known, total, knownPct,
                    st.empty, st.mature)
            statusLabel.TextColor3 = stateColor
            if startBtnRef then
                startBtnRef.btn.Text = Config.enabled and "RUNNING" or "START"
                startBtnRef.btn.BackgroundColor3 = Config.enabled and C.muted or C.green
            end
        end
    end
end)

